# Copie para .env (mesma pasta) e preencha. Só login-stage.mjs e exemplo-sdk/run.mjs leem este arquivo;
# o agente recebe tudo, menos QA_PASS. Valores abaixo são fictícios.

# --- Azure DevOps ---
ADO_ORG=https://dev.azure.com/minha-org
ADO_PROJECT=MeuProjeto
ADO_PAT=
REPO_NOME_BACK=minha-api
REPO_NOME_FRONT=meu-front
REPO_NOME_MVC=
REPO_NOME_DELPHI=meu-legado-delphi
DELPHI_SOURCE_DIR=Source
PIPELINE_BACK=
PIPELINE_FRONT=
PIPELINE_MVC=
STAGE_BRANCH=stage

# --- Pastas ---
REPOS_DIR=./repos
TESTES_DIR=./testes-card

# --- Stage (front) e login ---
QA_FRONT=https://stage.exemplo.local/app/
QA_USER=usuario.teste
QA_PASS=
QA_EMPRESA_PADRAO=1
# Seletores do formulário de login (ajuste ao seu sistema)
QA_LOGIN_SEL_USER=input[name=login]
QA_LOGIN_SEL_PASS=input[name=senha]
QA_LOGIN_SEL_SUBMIT=#btnLogin
QA_LOGIN_SEL_EMPRESA=#empresa
QA_LOGIN_SEL_EMPRESA_SUBMIT=#btnEmpresa
QA_LOGIN_URL_PATTERN=login

# --- Banco de evidência (Firebird, só leitura) ---
FB_DB=db.stage.exemplo.local:/bases/stage.fdb
FB_USER=sysdba
FB_PASS=
# Arquivo com as bases dos clientes (bloco ConnectionStrings com "Context<Cliente>")
QA_CONEXOES=./conexoes.txt

# --- Execução ---
QA_EXIGE_CRITERIO=1
QA_ESCREVE_ADO=0
QA_ESTADO_APROVADO=
QA_ESTADO_REPROVADO=
QA_ESTADO_BLOQUEADO=
QA_HEADLESS=1
QA_CHROME_EXE=
